{
  "policy_id": "personal-default",
  "mode": "personal",
  "label": "Personal self-use workspace",
  "data_rules": {
    "can_contain_private_operator_data": true,
    "can_contain_customer_data": false,
    "commit_allowed": false,
    "public_export_allowed": false,
    "white_label_required": false
  },
  "workflow_rules": {
    "strategy_confirmation_required_for_formal_topics": true,
    "pain_id_required_for_formal_topics": true,
    "allow_exploratory_topics_without_confirmation": true,
    "allow_internal_notes": true,
    "allow_fast_iteration_outputs": true
  },
  "export_rules": {
    "default_export_type": "internal",
    "must_remove_operator_identity": false,
    "must_remove_customer_identity": true
  }
}
