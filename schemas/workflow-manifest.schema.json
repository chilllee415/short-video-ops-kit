{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Manifest",
  "type": "object",
  "required": ["workflow_id", "purpose", "reads", "writes"],
  "properties": {
    "workflow_id": { "type": "string" },
    "purpose": { "type": "string" },
    "reads": { "type": "array", "items": { "type": "string" } },
    "optional_reads": { "type": "array", "items": { "type": "string" } },
    "upstream_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["workflow_id", "required_artifacts"],
        "properties": {
          "workflow_id": { "type": "string" },
          "dependency_type": {
            "type": "string",
            "enum": ["hard", "soft"]
          },
          "required_artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "handoff_policy": {
      "type": "string",
      "description": "How this workflow consumes upstream outputs without directly invoking upstream workflows."
    },
    "writes": { "type": "array", "items": { "type": "string" } },
    "must_not_write": { "type": "array", "items": { "type": "string" } },
    "requires_user_confirmation": { "type": "boolean" },
    "output_schema": { "type": "string" },
    "missing_data_behavior": { "type": "string" }
  }
}
