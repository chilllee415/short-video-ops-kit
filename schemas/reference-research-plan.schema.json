{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference Research Plan",
  "type": "object",
  "required": ["run_name", "workflow_id", "content_scene", "query_groups", "downstream_workflow"],
  "properties": {
    "run_name": { "type": "string" },
    "workflow_id": { "type": "string", "const": "reference-research-plan" },
    "generated_at": { "type": "string" },
    "stage_direction": { "type": "string" },
    "content_scene": { "type": "string" },
    "research_questions": { "type": "array", "items": { "type": "string" } },
    "platform_mix": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "query_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "sample_targets": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "inclusion_rules": { "type": "array", "items": { "type": "string" } },
    "exclusion_rules": { "type": "array", "items": { "type": "string" } },
    "transcript_policy": { "type": "string" },
    "downstream_workflow": { "type": "string" }
  },
  "additionalProperties": true
}
