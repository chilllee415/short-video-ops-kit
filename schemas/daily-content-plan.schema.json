{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Content Plan",
  "type": "object",
  "required": [
    "plan_id",
    "plan_date",
    "strategy_id",
    "strategy_assessment_id",
    "status",
    "source_dates",
    "research_summary",
    "plans",
    "command",
    "schedule"
  ],
  "properties": {
    "plan_id": { "type": "string", "minLength": 1 },
    "plan_date": { "type": "string", "format": "date" },
    "strategy_id": { "type": "string", "minLength": 1 },
    "strategy_assessment_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["ready", "degraded", "blocked"]
    },
    "source_dates": {
      "type": "object",
      "required": ["account", "topic", "reference"],
      "properties": {
        "account": { "type": "string" },
        "topic": { "type": "string" },
        "demand": { "type": "string" },
        "reference": { "type": "string" }
      },
      "additionalProperties": { "type": "string" }
    },
    "research_summary": {
      "type": "object",
      "required": ["account_signal", "topic_signal", "reference_signal"],
      "properties": {
        "account_signal": { "type": "string" },
        "topic_signal": { "type": "string" },
        "demand_signal": { "type": "string" },
        "reference_signal": { "type": "string" },
        "missing_or_blocked": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "command": {
      "type": "object",
      "required": ["titlePrefix", "highlight", "copy", "checks", "gates"],
      "properties": {
        "date": { "type": "string" },
        "titlePrefix": { "type": "string" },
        "highlight": { "type": "string" },
        "copy": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array", "items": { "type": "string" } },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        }
      }
    },
    "schedule": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "text"],
        "properties": {
          "time": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "plans": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "topic_id",
          "strategy_id",
          "strategy_assessment_id",
          "search_scope_ids",
          "signal_ids",
          "reference_ids",
          "evidence_ids",
          "type",
          "label",
          "score",
          "title",
          "hook",
          "visible_result",
          "cta",
          "steps",
          "meta"
        ],
        "properties": {
          "topic_id": { "type": "string", "minLength": 1 },
          "pain_id": { "type": "string", "minLength": 1 },
          "strategy_id": { "type": "string", "minLength": 1 },
          "strategy_assessment_id": { "type": "string", "minLength": 1 },
          "search_scope_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "signal_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "reference_ids": { "type": "array", "items": { "type": "string" } },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "type": { "type": "string", "enum": ["primary", "convert", "lab"] },
          "label": { "type": "string" },
          "icon": { "type": "string" },
          "score": { "type": "string" },
          "title": { "type": "string" },
          "hook": { "type": "string" },
          "visible_result": { "type": "string" },
          "cta": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["time", "text"],
              "properties": {
                "time": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          },
          "meta": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["ready", "degraded"] } },
        "required": ["status"]
      },
      "then": {
        "properties": { "plans": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "blocked" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "plans": { "maxItems": 0 } }
      }
    }
  ]
}
