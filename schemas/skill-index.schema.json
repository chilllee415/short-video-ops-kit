{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Index",
  "type": "object",
  "required": ["skill_index_version", "scope", "skills"],
  "properties": {
    "skill_index_version": { "type": "string" },
    "scope": { "type": "string", "enum": ["repository", "workspace"] },
    "last_reviewed": { "type": "string" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skill_id", "name", "source_path", "class", "status"],
        "properties": {
          "skill_id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "source_path": { "type": "string" },
          "class": {
            "type": "string",
            "enum": [
              "system",
              "workspace",
              "raw_legacy",
              "personal",
              "commercial_candidate",
              "distilled"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["active", "archived", "needs_review", "blocked"]
          },
          "contains_private_data": { "type": "boolean" },
          "commercial_safe": { "type": "boolean" },
          "owner_workflows": {
            "type": "array",
            "items": { "type": "string" }
          },
          "promotion_requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
