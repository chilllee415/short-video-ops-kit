{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace Policy",
  "type": "object",
  "required": ["policy_id", "mode", "data_rules", "workflow_rules", "export_rules"],
  "properties": {
    "policy_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["personal", "commercial"] },
    "label": { "type": "string" },
    "data_rules": {
      "type": "object",
      "required": ["commit_allowed", "public_export_allowed", "white_label_required"],
      "properties": {
        "can_contain_private_operator_data": { "type": "boolean" },
        "can_contain_customer_data": { "type": "boolean" },
        "commit_allowed": { "type": "boolean" },
        "public_export_allowed": { "type": "boolean" },
        "white_label_required": { "type": "boolean" }
      }
    },
    "workflow_rules": {
      "type": "object",
      "required": ["strategy_confirmation_required_for_formal_topics", "pain_id_required_for_formal_topics"],
      "properties": {
        "strategy_confirmation_required_for_formal_topics": { "type": "boolean" },
        "pain_id_required_for_formal_topics": { "type": "boolean" },
        "allow_exploratory_topics_without_confirmation": { "type": "boolean" },
        "allow_internal_notes": { "type": "boolean" },
        "allow_fast_iteration_outputs": { "type": "boolean" }
      }
    },
    "export_rules": {
      "type": "object",
      "required": ["default_export_type"],
      "properties": {
        "default_export_type": { "type": "string" },
        "must_remove_operator_identity": { "type": "boolean" },
        "must_remove_customer_identity": { "type": "boolean" }
      }
    }
  }
}
